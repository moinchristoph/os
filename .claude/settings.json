{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(security find-generic-password*)",
      "Bash(security find-internet-password*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npm run deploy*)",
      "Edit(**/CLAUDE.md)",
      "Write(**/CLAUDE.md)",
      "Edit(**/.claude/settings*.json)",
      "Write(**/.claude/settings*.json)",
      "Edit(~/.claude/settings.json)",
      "Write(~/.claude/settings.json)"
    ]
  }
}
